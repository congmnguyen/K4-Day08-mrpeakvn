# OpenAI API Key — BẮT BUỘC.
# Dùng cho cả embedding (Task 4/5) và generation (Task 10).
OPENAI_API_KEY=sk-proj-...

# Embedding model (Task 4/5). Đổi model phải xoá chroma_db/ và chạy lại Task 4
# vì dimension khác nhau không tương thích ngược.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat model cho Task 10.
OPENAI_CHAT_MODEL=gpt-4o-mini

# PageIndex API Key (Tùy chọn — Task 8).
# Không set thì Task 8 tự động chạy fallback local structure-aware trên
# data/standardized/, không gọi API.
# PAGEINDEX_API_KEY=pix_...
